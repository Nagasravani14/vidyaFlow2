# ==============================================================================
# VidyaFlow Generator - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for live AI generation)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model for bulk generation (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Fallback stronger model for retries or complex chapters
GEMINI_FALLBACK_MODEL=gemini-1.5-pro

# Rate limiting and retry backoff
GEMINI_REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0

# Optical Character Recognition (OCR) configuration
# Set to true to attempt Tesseract OCR on low-text scanned pages
OCR_ENABLED=true
